//@version=6
indicator("P5 ties on a synthetic periodic series")
var array<float> pattern = array.from(100.0, 101.0, 102.0, 102.0, 101.0, 100.0, 99.0, 99.0, 100.0, 103.0, 103.0, 103.0, 101.0, 100.0, 98.0, 98.0, 99.0, 101.0, 101.0, 100.0, 104.0, 102.0, 102.0, 104.0, 103.0, 101.0, 100.0, 100.0, 102.0, 105.0)
int phase = bar_index % 30
float s = array.get(pattern, phase)
float sWithNa = phase % 7 == 3 ? na : s
plot(phase, title = "PHASE")
plot(s, title = "S")
plot(ta.highestbars(s, 5), title = "HIGHESTBARS5")
plot(ta.lowestbars(s, 5), title = "LOWESTBARS5")
plot(ta.pivothigh(s, 2, 2), title = "PIVOTHIGH_2_2")
plot(ta.pivotlow(s, 2, 2), title = "PIVOTLOW_2_2")
plot(ta.pivothigh(s, 3, 1), title = "PIVOTHIGH_3_1")
plot(ta.highest(sWithNa, 5), title = "HIGHEST5_NA")
plot(ta.lowest(sWithNa, 5), title = "LOWEST5_NA")

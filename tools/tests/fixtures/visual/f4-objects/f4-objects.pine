//@version=6
indicator("F4 objects", overlay=true)
var line l1 = na
var line l2 = na
if bar_index == 50
    l1 := line.new(bar_index, low, bar_index + 30, high, color=color.orange, width=1)
    l2 := line.new(bar_index, high, bar_index + 30, low, color=color.blue, width=1)
    linefill.new(l1, l2, color.new(color.yellow, 85))
if bar_index == 200
    pts = array.new<chart.point>()
    pts.push(chart.point.from_index(bar_index, low))
    pts.push(chart.point.from_index(bar_index + 15, high))
    pts.push(chart.point.from_index(bar_index + 30, low))
    polyline.new(pts, line_color=color.teal, line_width=2)
if bar_index == 300
    label.new(time, high, "time-anchored", xloc=xloc.bar_time, style=label.style_label_down, color=color.navy, textcolor=color.white)
